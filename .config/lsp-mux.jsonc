// Language servers for this project, run by lsp-mux (howmanysmall-lsps plugin).
{
	"routes": {
		"textDocument/formatting": {
			"servers": ["oxfmt", "biome", "rumdl"],
		},
		"textDocument/rangeFormatting": {
			"servers": ["oxfmt", "biome", "rumdl"],
		},
	},
	"servers": {
		"bash": {
			"args": ["start"],
			"command": "bash-language-server",
			"extensions": [".bash", ".ksh", ".sh", ".zsh"],
		},
		"biome": {
			"args": ["lsp-proxy"],
			"command": "biome",
			"extensions": [
				".astro",
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".html",
				".js",
				".json",
				".jsonc",
				".jsx",
				".mjs",
				".mts",
				".scss",
				".svelte",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml",
			],
			"requireRootMarker": true,
			"rootMarkers": ["biome.json", "biome.jsonc"],
		},
		"eslint": {
			"args": ["--stdio"],
			"command": "vscode-eslint-language-server",
			"extensions": [
				".cjs",
				".cts",
				".js",
				".json",
				".json5",
				".jsonc",
				".jsx",
				".mjs",
				".mts",
				".ts",
				".tsx",
				".yaml",
				".yml",
			],
			"requireRootMarker": true,
			"rootMarkers": ["eslint.config.ts", "eslint.config.js", "eslint.config.mjs", "eslint.config.cjs"],
			"settings": {
				"codeAction": {
					"disableRuleComment": {
						"enable": true,
						"location": "separateLine",
					},
					"showDocumentation": {
						"enable": true,
					},
				},
				"codeActionOnSave": {
					"mode": "all",
				},
				"experimental": {},
				"format": false,
				"nodePath": null,
				"onIgnoredFiles": "off",
				"options": {},
				"problems": {
					"shortenToSingleLine": false,
				},
				"quiet": false,
				"rulesCustomizations": [],
				"run": "onType",
				"useESLintClass": false,
				"useFlatConfig": true,
				"validate": "on",
				"workingDirectory": {
					"mode": "auto",
				},
			},
		},
		"oxfmt": {
			"args": ["--lsp"],
			"command": "oxfmt",
			"extensions": [
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".handlebars",
				".hbs",
				".htm",
				".html",
				".js",
				".json",
				".json5",
				".jsonc",
				".jsx",
				".less",
				".mdx",
				".mjs",
				".mts",
				".sass",
				".scss",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml",
			],
			"requireRootMarker": true,
			"rootMarkers": [".oxfmtrc.json", ".oxfmtrc.jsonc"],
		},
		"oxlint": {
			"args": ["--lsp"],
			"command": "oxlint",
			"extensions": [".astro", ".cjs", ".cts", ".js", ".jsx", ".mjs", ".mts", ".svelte", ".ts", ".tsx", ".vue"],
			"requireRootMarker": true,
			"rootMarkers": [".oxlintrc.json", "oxlint.config.ts"],
		},
		"rumdl": {
			"args": ["server"],
			"command": "rumdl",
			"extensions": [
				".Rmd",
				".markdown",
				".md",
				".mdown",
				".mdtext",
				".mdtxt",
				".mdwn",
				".mkd",
				".mkdn",
				".text",
			],
		},
		"tombi": {
			"args": ["lsp"],
			"command": "tombi",
			"extensions": [".toml"],
		},
		"typescript": {
			"args": ["--lsp", "--stdio"],
			"command": "tsc",
			"extensions": [".ts", ".tsx", ".mts", ".cts"],
			"rootMarkers": ["tsconfig.json", "jsconfig.json"],
		},
		"vale": {
			"command": "vale-ls",
			"extensions": [".markdown", ".md", ".mdx"],
			"requireRootMarker": true,
			"rootMarkers": [".vale.ini"],
		},
		"yaml": {
			"args": ["--stdio"],
			"command": "yaml-language-server",
			"extensions": [".yaml", ".yml"],
		},
	},
}
