{
	"name": "@pobammer-ts/lsp-mux",
	"version": "3.1.2",
	"description": "Run several language servers behind one LSP connection, configured with `defineConfiguration`.",
	"keywords": [
		"language-server",
		"lsp",
		"multiplexer",
		"claude-code",
		"slop"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/howmanysmall/claude-plugins.git",
		"directory": "packages/lsp-mux"
	},
	"license": "MIT",
	"author": {
		"name": "HowManySmall",
		"email": "contact@howmanysmall.com",
		"url": "https://howmanysmall.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"lsp-mux": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "turbo run build --filter=@pobammer-ts/lsp-mux",
		"test": "vitest run",
		"test:agent": "node --run test -- --reporter agent",
		"type-check": "tsc --build"
	},
	"dependencies": {
		"@cliffy/command": "catalog:runtime",
		"@cliffy/prompt": "catalog:runtime",
		"@inquirer/core": "catalog:runtime",
		"@inquirer/prompts": "catalog:runtime",
		"@inquirer/type": "catalog:runtime",
		"arktype": "catalog:runtime",
		"c12": "catalog:runtime",
		"effect": "catalog:runtime",
		"jsonc-parser": "catalog:runtime",
		"just-diff": "catalog:runtime",
		"type-fest": "catalog:types"
	},
	"devDependencies": {
		"@fast-check/vitest": "catalog:test",
		"@howmanysmall/arktype-utilities": "workspace:*",
		"@howmanysmall/cli-utilities": "workspace:*",
		"@howmanysmall/project-configurations": "workspace:*",
		"@total-typescript/ts-reset": "catalog:types",
		"@types/node": "catalog:types",
		"@vitiate/core": "catalog:test",
		"@vitiate/fuzzed-data-provider": "catalog:test",
		"fast-check": "catalog:test",
		"tsdown": "catalog:build",
		"unplugin-macros": "catalog:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
