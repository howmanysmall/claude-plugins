{
	"$schema": "https://raw.githubusercontent.com/apmantza/pi-lens/master/docs/schema/pi-lens-config-v1.json",
	"dispatch": {
		"disabledRunners": ["taplo"]
	},
	"lsp": {
		"serverOverrides": {
			"toml": {
				"command": ["tombi", "lsp"]
			},
			"typescript": {
				"command": ["tsrs", "--lsp", "--stdio"]
			}
		},
		"servers": {
			"rumdl": {
				"command": ["rumdl", "server"],
				"extensions": [
					".markdown",
					".md",
					".mdown",
					".mdtext",
					".mdtxt",
					".mdwn",
					".mkd",
					".mkdn",
					".Rmd",
					".text"
				],
				"name": "rumdl"
			}
		}
	}
}
