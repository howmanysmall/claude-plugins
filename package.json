{
	"name": "@howmanysmall/claude-plugins",
	"version": "0.0.0",
	"private": true,
	"description": "Claude Code plugin marketplace by howmanysmall, with the source of the lsp-mux LSP multiplexer.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"biome": "biome",
		"build": "tsdown --workspace",
		"commitlint": "commitlint",
		"format": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); node --run biome -- check --fix $a && node --run oxfmt -- $a' _",
		"format:check": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); node --run biome -- check --no-errors-on-unmatched $a && node --run oxfmt -- --no-error-on-unmatched-pattern --check $a' _",
		"format:safe": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); node --run biome -- check --no-errors-on-unmatched --fix $a && node --run oxfmt -- --no-error-on-unmatched-pattern $a' _",
		"hooks:install": "hk install --mise",
		"hooks:validate": "hk validate",
		"isentinel-lint": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=6144\" isentinel-lint --concurrency=off",
		"jiti": "jiti",
		"lint": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); node --run isentinel-lint -- $a && node --run biome -- check --no-errors-on-unmatched $a' _",
		"lint:agent": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); node --run isentinel-lint -- --agents $a && node --run biome -- check --no-errors-on-unmatched --reporter concise $a' _",
		"oxfmt": "oxfmt",
		"oxlint": "oxlint",
		"release": "bumpp",
		"test": "vitest run",
		"test:agent": "vitest run --reporter agent",
		"tsc": "tsc",
		"type-check": "tsc --build",
		"type-check:agent": "node --run type-check -- --pretty false",
		"preversion": "if test -n \"$(git status --porcelain)\"; then echo 'Release requires a clean worktree.' >&2; exit 1; fi"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "catalog:build",
		"@biomejs/biome": "catalog:lint",
		"@commitlint/cli": "catalog:commitlint",
		"@commitlint/config-conventional": "catalog:commitlint",
		"@commitlint/types": "catalog:commitlint",
		"@e18e/eslint-plugin": "catalog:lint",
		"@howmanysmall/lint-configurations": "workspace:*",
		"@isentinel/eslint-config": "catalog:lint",
		"@isentinel/hooks": "catalog:tooling",
		"@pobammer-ts/lsp-mux": "workspace:*",
		"@pobammer-ts/small-rules": "catalog:lint",
		"@stylistic/eslint-plugin": "catalog:lint",
		"@types/node": "catalog:types",
		"@vitest/eslint-plugin": "catalog:lint",
		"bumpp": "catalog:tooling",
		"eslint": "catalog:lint",
		"eslint-plugin-antfu": "catalog:lint",
		"eslint-plugin-better-max-params": "catalog:lint",
		"eslint-plugin-comment-length": "catalog:lint",
		"eslint-plugin-de-morgan": "catalog:lint",
		"eslint-plugin-eslint-plugin": "catalog:lint",
		"eslint-plugin-flawless": "catalog:lint",
		"eslint-plugin-jest-extended": "catalog:lint",
		"eslint-plugin-jsdoc": "catalog:lint",
		"eslint-plugin-n": "catalog:lint",
		"eslint-plugin-oxfmt": "catalog:lint",
		"eslint-plugin-perfectionist": "catalog:lint",
		"eslint-plugin-pnpm": "catalog:lint",
		"eslint-plugin-react-jsx": "catalog:lint",
		"eslint-plugin-react-naming-convention": "catalog:lint",
		"eslint-plugin-react-x": "catalog:lint",
		"eslint-plugin-roblox-ts": "catalog:lint",
		"eslint-plugin-sonarjs": "catalog:lint",
		"eslint-plugin-unicorn": "catalog:lint",
		"eslint-plugin-unused-imports": "catalog:lint",
		"jest-extended": "catalog:test",
		"jiti": "catalog:tooling",
		"oxfmt": "catalog:lint",
		"oxlint": "catalog:lint",
		"oxlint-plugin-react-doctor": "catalog:lint",
		"oxlint-tsgolint": "catalog:lint",
		"publint": "catalog:build",
		"tsdown": "catalog:build",
		"type-fest": "catalog:types",
		"typescript": "catalog:tooling",
		"typescript7": "catalog:tooling",
		"vitest": "catalog:test"
	},
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=22.12.0"
	}
}
